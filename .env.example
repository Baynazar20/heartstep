# Site (optional)
PING_MESSAGE=ping
VITE_PLAY_URL=https://play.google.com/store/search?q=HeartStep&c=apps

# Gemini 2.5 Flash Image (required for PECS card generation)
GEMINI_API_KEY=your_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Rate limit per IP per day (default 10)
PECS_RATE_LIMIT_PER_IP=10
